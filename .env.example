POSTGRES_USER=sports_user
POSTGRES_PASSWORD=sports_pass
POSTGRES_DB=iitg_sports
POSTGRES_PORT=5433
DATABASE_URL="postgresql://sports_user:sports_pass@localhost:5433/iitg_sports?schema=public"

# ── Redis ─────────────────────────────────────────────────────
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Email (optional, stubbed by default) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@iitg-sports.in
