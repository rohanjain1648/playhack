// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  admin
}

enum BookingStatus {
  confirmed
  cancelled
  no_show
}

enum SlotStatus {
  available
  booked
  maintenance
  closed
}

enum NotificationType {
  booking_confirmed
  booking_cancelled
  waitlist_joined
  waitlist_promoted
  waitlist_expired
  slot_maintenance
  reminder
}

model User {
  id           String   @id @default(uuid())
  rollNo       String   @unique @map("roll_no")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(student)
  priority     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  bookings      Booking[]
  waitlistItems WaitlistItem[]
  notifications Notification[]
  maintenanceWindows MaintenanceWindow[]

  @@map("users")
}

model Facility {
  id          String  @id @default(uuid())
  name        String
  type        String
  capacity    Int     @default(1)
  description String?
  imageUrl    String? @map("image_url")
  location    String?
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  slots              Slot[]
  maintenanceWindows MaintenanceWindow[]

  @@map("facilities")
}

model Slot {
  id         String     @id @default(uuid())
  facilityId String     @map("facility_id")
  date       DateTime   @db.Date
  startTime  String     @map("start_time") // "06:00"
  endTime    String     @map("end_time")   // "07:00"
  status     SlotStatus @default(available)
  version    Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  facility     Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  booking      Booking?
  waitlistItems WaitlistItem[]

  @@unique([facilityId, date, startTime], name: "unique_slot")
  @@index([facilityId, date])
  @@map("slots")
}

model Booking {
  id          String        @id @default(uuid())
  slotId      String        @unique @map("slot_id") // ★ THE KEY UNIQUENESS CONSTRAINT
  userId      String        @map("user_id")
  status      BookingStatus @default(confirmed)
  bookedAt    DateTime      @default(now()) @map("booked_at")
  cancelledAt DateTime?     @map("cancelled_at")

  slot Slot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("bookings")
}

model WaitlistItem {
  id          String    @id @default(uuid())
  slotId      String    @map("slot_id")
  userId      String    @map("user_id")
  position    Int
  joinedAt    DateTime  @default(now()) @map("joined_at")
  notifiedAt  DateTime? @map("notified_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")

  slot Slot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slotId, userId])
  @@index([slotId, position])
  @@map("waitlist_items")
}

model MaintenanceWindow {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  startDt    DateTime @map("start_dt")
  endDt      DateTime @map("end_dt")
  reason     String?
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])

  @@map("maintenance_windows")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
